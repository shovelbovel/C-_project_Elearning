@model IEnumerable<Elearning.Models.Course>
@using System.Text.RegularExpressions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="mb-0">Cours</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Formateur"))
    {
        <a class="btn btn-primary" asp-action="Create">Créer un cours</a>
    }
</div>

<div class="row g-4">
    @foreach (var course in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-primary bg-opacity-10 text-primary mb-2 align-self-start">
                        @(course.Category ?? "General")
                    </span>
                    <h5 class="card-title fw-semibold">@course.Title</h5>
                    @if (!string.IsNullOrEmpty(course.Description))
                    {
                        <p class="card-text text-muted small flex-grow-1">
                            @(course.Description.Length > 120 ? course.Description.Substring(0, 120) + "..." : course.Description)
                        </p>
                    }
                    <div class="text-muted small mb-3">
                        <span class="me-3">@(course.Lessons?.Count ?? 0) leçons</span>
                        <span>@(course.Quizzes?.Count ?? 0) quiz</span>
                    </div>
                    <div class="mt-auto d-flex gap-2">
                        <a class="btn btn-outline-primary btn-sm flex-grow-1" asp-action="Details" asp-route-id="@course.Id">Détails</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@course.Id">Supprimer</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="text-muted">Aucun cours disponible.</p>
        @if (User.IsInRole("Admin") || User.IsInRole("Formateur"))
        {
            <a class="btn btn-primary" asp-action="Create">Créer le premier cours</a>
        }
    </div>
}