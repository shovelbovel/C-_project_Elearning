@{
    ViewData["Title"] = "About Us";
}

<section class="py-5">
    <div class="container">
        <h1 class="mb-4">About Elearning</h1>

        <p class="lead">Elearning is a platform dedicated to providing high-quality online courses, interactive quizzes and practical certificates to help learners grow their skills and advance their careers.</p>

        <div class="row mt-5">
            <div class="col-md-6">
                <h3>Our Mission</h3>
                <p>We aim to make education accessible, practical and engaging. Our courses are designed by experienced instructors and focus on hands-on learning and real-world skills.</p>

                <h3 class="mt-4">What we offer</h3>
                <ul>
                    <li>Structured courses across multiple domains (development, cloud, data, design, security).</li>
                    <li>Interactive quizzes to test knowledge and reinforce learning.</li>
                    <li>Certificates to showcase achievements upon successful completion.</li>
                </ul>
            </div>

            <div class="col-md-6">
                <h3>Our Team</h3>
                <p>Our team is composed of developers, designers and educators passionate about building practical learning experiences. We collaborate with industry experts to keep content up-to-date.</p>

                <h3 class="mt-4">Contact</h3>
                <p>If you have questions, partnership requests or feedback, please contact us at <a href="mailto:contact@elearning.local">contact@elearning.local</a>.</p>
            </div>
        </div>

        <div class="mt-5">
            <h3>Careers & Partnerships</h3>
            <p>We are always looking for instructors, content creators and partners. If you are interested in collaborating, please reach out.</p>
        </div>
    </div>
</section>
