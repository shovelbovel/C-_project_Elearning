@model Elearning.Models.Course

@{
    ViewData["Title"] = Model.Title;
}

<div class="card mb-4">
    <div class="card-body">
        <span class="badge bg-primary bg-opacity-10 text-primary mb-2">@(Model.Category ?? "General")</span>
        <h1 class="mb-2">@Model.Title</h1>
        <p class="text-muted">@Model.Description</p>

        <div class="d-flex gap-3 text-muted small mb-4">
            <span>@Model.Lessons.Count leçons</span>
            <span>@Model.Quizzes.Count quiz</span>
        </div>

        <h3 class="mb-3">Leçons</h3>
        @if (Model.Lessons?.Any() ?? false)
        {
            <div class="row g-3">
                @foreach (var lesson in Model.Lessons.OrderBy(l => l.Order))
                {
                    <div class="col-md-6">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary me-2">@lesson.Order</span>
                                <h5 class="d-inline">@lesson.Title</h5>
                                <p class="text-muted small mt-2 mb-0">
                                    @((!string.IsNullOrEmpty(lesson.Content) ? (lesson.Content.Length > 100 ? lesson.Content.Substring(0, 100) + "..." : lesson.Content) : ""))
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Aucune leçon disponible.</p>
        }

        <h3 class="mt-4 mb-3">Quiz</h3>
        @if (Model.Quizzes?.Any() ?? false)
        {
            <div class="list-group">
                @foreach (var quiz in Model.Quizzes)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@quiz.Title</strong>
                            <div class="text-muted small">Seuil: @quiz.PassPercentage% | @(quiz.Questions?.Count ?? 0) questions</div>
                        </div>
                        <div>
                            <a class="btn btn-sm btn-outline-primary me-2" asp-controller="Quiz" asp-action="Details" asp-route-id="@quiz.Id">Détails</a>
                            <a class="btn btn-sm btn-primary" asp-controller="Quiz" asp-action="Take" asp-route-id="@quiz.Id">Passer</a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Aucun quiz disponible.</p>
        }
    </div>
</div>