@model IEnumerable<Elearning.Models.Course>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Home Page";
}

<!-- Hero section avec gradient -->
<div class="hero-section py-5 text-center mb-4" role="region" aria-labelledby="hero-heading">
    <div class="hero-icon mb-3">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 14l9-5-9-5-9 5 9 5z"/>
            <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
        </svg>
    </div>
    <h1 id="hero-heading" class="display-5 fw-bold mb-3">Learn. Grow. Succeed.</h1>
    <p class="lead text-muted mx-auto" style="max-width: 600px;">
        Bienvenue sur Elearning — des cours structurés, des quiz interactifs et des certificats.
    </p>
    <div class="mt-4">
        <a class="btn btn-primary btn-lg px-4" asp-controller="Course" asp-action="Index">Explorer les cours</a>
    </div>
</div>

<!-- Stats section -->
<section class="row text-center g-4 mb-4">
    <div class="col-4">
        <div class="stat-number h2 fw-bold text-primary">@(Model?.Count() ?? 0)</div>
        <div class="text-muted small">Cours</div>
    </div>
    <div class="col-4">
        <div class="stat-number h2 fw-bold text-primary">@(Model?.Sum(c => c.Quizzes?.Count ?? 0) ?? 0)</div>
        <div class="text-muted small">Quiz</div>
    </div>
    <div class="col-4">
        <div class="stat-number h2 fw-bold text-primary">@(Model?.Sum(c => c.Lessons?.Count ?? 0) ?? 0)</div>
        <div class="text-muted small">Leçons</div>
    </div>
</section>

<section aria-labelledby="courses-heading" class="mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 id="courses-heading" class="mb-0">Cours en vedette</h2>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Course" asp-action="Index">Voir tout</a>
    </div>

    <div class="row mt-3 gx-3 gy-4">
        @foreach (var c in (Model ?? Enumerable.Empty<Elearning.Models.Course>()).Take(6))
        {
            <div class="col-12 col-md-6 col-lg-4">
                <article class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-primary bg-opacity-10 text-primary mb-2 align-self-start">
                            @(c.Category ?? "General")
                        </span>
                        <h5 class="card-title fw-semibold">@c.Title</h5>
                        @if (!string.IsNullOrEmpty(c.Description))
                        {
                            <p class="card-text text-muted small flex-grow-1">
                                @(c.Description.Length > 100 ? c.Description.Substring(0, 100) + "..." : c.Description)
                            </p>
                        }
                        <div class="text-muted small mb-3">
                            <span class="me-3">@(c.Lessons?.Count ?? 0) leçons</span>
                            <span>@(c.Quizzes?.Count ?? 0) quiz</span>
                        </div>
                        <a class="btn btn-outline-primary btn-sm mt-auto" asp-controller="Course" asp-action="Details" asp-route-id="@c.Id">Voir le cours</a>
                    </div>
                </article>
            </div>
        }
    </div>
</section>

<style>
    .hero-section { background: linear-gradient(135deg, rgba(43,108,176,0.08), rgba(43,108,176,0.02)); border-radius: var(--radius); }
    .hero-icon { color: var(--accent); }
</style>
