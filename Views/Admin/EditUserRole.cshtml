@model Elearning.Models.EditUserRoleViewModel

@{
    ViewData["Title"] = "Edit User Role";
}

<h1>Edit Role for @Model.FullName</h1>

<form method="post" asp-action="EditUserRole" novalidate class="needs-validation" id="roleForm">
    <input type="hidden" asp-for="UserId" />
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" readonly />
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <select asp-for="SelectedRoleId" asp-items="Model.Roles" class="form-select" required></select>
        <div class="invalid-feedback">Please select a role.</div>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary" id="saveBtn">Save</button>
        <a asp-action="Users" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        // Bootstrap client-side validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    } else {
                        // Show confirmation before submitting
                        if (!confirm('Are you sure you want to change this user\'s role?')) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}