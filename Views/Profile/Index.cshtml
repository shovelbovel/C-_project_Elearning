@model Elearning.Models.User

@{
    ViewData["Title"] = "Profile";
}

<h1>Your profile</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card stat-card mb-3">
            <div class="card-body">
                <h5>@Model.FullName</h5>
                <p class="text-muted">@Model.Email</p>
                <p><strong>Role:</strong> @Model.Role?.Name</p>
                <p><strong>Theme preference:</strong> @Model.ThemePreference</p>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit">Edit profile</a>
            </div>
        </div>
    </div>
</div>