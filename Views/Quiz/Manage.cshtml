@model Elearning.Models.Quiz
@using System.Text.RegularExpressions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    ViewData["Title"] = "Gérer le Quiz - " + Model.Title;
}

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-start mb-4">
            <div class="quiz-icon bg-primary bg-opacity-10 text-primary me-3" style="width:56px;height:56px;border-radius:12px;display:flex;align-items:center;justify-content:center;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/>
                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
            </div>
            <div>
                <h2 class="mb-1">@Model.Title</h2>
                <p class="text-muted mb-0">Cours: @Model.Course?.Title</p>
            </div>
        </div>

        <h4 class="mt-4 mb-3">Questions</h4>
        <div class="mb-3">
            <form method="post" asp-action="AddQuestion" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="quizId" value="@Model.Id" />
                <input name="text" class="form-control" placeholder="Nouvelle question..." />
                <button class="btn btn-primary">Ajouter</button>
            </form>
        </div>

        <ul class="list-group" id="questions-list">
            @foreach (var q in Model.Questions)
            {
                <li class="list-group-item" data-id="@q.Id">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong>@q.Text</strong>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-secondary drag-handle" title="Réordonner">??</button>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="EditQuestion" asp-route-id="@q.Id">Modifier</a>
                            <form method="post" asp-action="DeleteQuestion" asp-route-id="@q.Id" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                            </form>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="text-muted small mb-2">Réponses:</div>
                        <ul class="list-unstyled ps-3">
                            @foreach (var a in q.Answers)
                            {
                                <li class="d-flex align-items-center gap-2 mb-2">
                                    @if (a.IsCorrect)
                                    {
                                        <span class="badge bg-success">?</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted">?</span>
                                    }
                                    <span>@a.Text</span>
                                    <div class="ms-auto d-flex gap-1">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditAnswer" asp-route-id="@a.Id">Modifier</a>
                                        <form method="post" asp-action="DeleteAnswer" asp-route-id="@a.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger">×</button>
                                        </form>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </li>
            }
        </ul>

        <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-link mt-3">? Retour au cours</a>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            const list = document.getElementById('questions-list');
            let dragEl = null;

            list.addEventListener('dragstart', function(e){
                if(e.target && e.target.matches('li.list-group-item')){
                    dragEl = e.target;
                    e.dataTransfer.effectAllowed = 'move';
                }
            });

            list.addEventListener('dragover', function(e){
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                const target = e.target.closest('li.list-group-item');
                if(target && target !== dragEl){
                    const rect = target.getBoundingClientRect();
                    const next = (e.clientY - rect.top) / rect.height > 0.5;
                    list.insertBefore(dragEl, next ? target.nextSibling : target);
                }
            });

            list.addEventListener('dragend', function(){
                dragEl = null;
                sendOrder();
            });

            document.querySelectorAll('.drag-handle').forEach(btn => {
                btn.addEventListener('mousedown', function(e){
                    const li = e.target.closest('li.list-group-item');
                    if(li){ li.setAttribute('draggable', 'true'); }
                });
                btn.addEventListener('mouseup', function(e){
                    const li = e.target.closest('li.list-group-item');
                    if(li){ li.removeAttribute('draggable'); }
                });
            });

            function sendOrder(){
                const ids = Array.from(list.querySelectorAll('li.list-group-item')).map(li => parseInt(li.getAttribute('data-id')));
                fetch('@Url.Action("ReorderQuestions", "Quiz")?quizId=' + @Model.Id, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(ids)
                });
            }
        })();
    </script>
}