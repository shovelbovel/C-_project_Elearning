@model IEnumerable<Elearning.Models.Course>

@{
    ViewData["Title"] = "Formateur Dashboard";
}

<h1>Formateur Dashboard</h1>

<p>List of courses to manage:</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Title</td>
                <td>@c.Category</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-controller="Course" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-controller="Course" asp-action="Delete" asp-route-id="@c.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>