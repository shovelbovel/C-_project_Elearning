@model Elearning.Models.Answer

@{
    ViewData["Title"] = "Edit Answer";
}

<div class="card">
    <div class="card-body">
        <h2>Edit Answer</h2>

        <form method="post" asp-action="EditAnswer" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Answer text</label>
                <input name="text" value="@Model.Text" class="form-control" />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="isCorrect" value="true" @(Model.IsCorrect ? "checked" : "") />
                <label class="form-check-label">Is correct</label>
            </div>
            <div class="d-grid">
                <button class="btn btn-primary">Save</button>
            </div>
        </form>

        <a asp-action="EditQuestion" asp-route-id="@Model.QuestionId" class="btn btn-link mt-3">Back to question</a>
    </div>
</div>