<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Elearning</title>

    <!-- TEMPLATE CSS -->
    <link rel="stylesheet" href="~/assets/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/vendor/aos/aos.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <a href="#main-content" class="visually-hidden focusable">Skip to main content</a>

    <!-- include icons -->
    <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
        <defs>
            <!-- inline icon sprite contents to ensure availability -->
            <symbol id="icon-search" viewBox="0 0 24 24"> <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79L20 21.5 21.5 20l-5.99-6z" fill="currentColor"/></symbol>
            <symbol id="icon-user" viewBox="0 0 24 24"> <path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-4.4 0-8 2.2-8 4v2h16v-2c0-1.8-3.6-4-8-4z" fill="currentColor"/></symbol>
            <symbol id="icon-sun" viewBox="0 0 24 24"><path d="M6.76 4.84l-1.8-1.79L3.17 4.84l1.79 1.79 1.8-1.79zM1 13h3v-2H1v2zm10-9h2V1h-2v3zm7.03 2.05l1.79-1.8-1.79-1.79-1.8 1.79 1.8 1.8zM17.24 19.16l1.8 1.79 1.79-1.79-1.79-1.79-1.8 1.79zM20 11v2h3v-2h-3zM12 7a5 5 0 100 10 5 5 0 000-10zM4.24 19.16l1.8-1.79-1.8-1.79-1.79 1.79 1.79 1.79z" fill="currentColor"/></symbol>
            <symbol id="icon-moon" viewBox="0 0 24 24"><path d="M12.3 2.1c.2 0 .4 0 .6.1C10.9 3 9.1 4.5 8 6.6c-1.9 3.3-1.1 7.4 2 9.6 3.2 2.2 7.5 1.8 10.2-1.1C22 13.3 22.6 9 20.5 6.1 18.4 3.2 15.1 2.1 12.3 2.1c0 0 0 0 0 0z" fill="currentColor"/></symbol>
        </defs>
    </svg>

    <!-- HEADER / NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3" role="navigation">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-real.svg" alt="Elearning logo" style="height:34px;" />
                    <span class="fw-bold">Elearning</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Course" asp-action="Index">Courses</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item d-flex align-items-center me-2">
                            <button class="btn btn-outline-secondary btn-sm" id="themeToggle" aria-label="Toggle theme">
                                <svg width="18" height="18" aria-hidden="true"><use href="#icon-sun"></use></svg>
                            </button>
                        </li>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Admin" asp-action="Index">Admin</a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <svg width="20" height="20" class="me-2" aria-hidden="true"><use href="#icon-user"></use></svg>
                                    <span class="d-none d-sm-inline">@User.Identity?.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Profile</a></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="LogoutPost" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Auth" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- alerts -->
    <div class="container mt-2">
        <partial name="_Alerts" />
    </div>

    <!-- MAIN CONTENT -->
    <div class="container site-main" id="main-content">
        <main role="main" class="pb-3 fade-in">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="bg-light text-center text-lg-start mt-auto py-4 border-top site-footer" role="contentinfo">
        <div class="container">
            <p class="text-muted mb-0">&copy; 2025 Elearning Platform. All rights reserved.</p>
        </div>
    </footer>

    <!-- TEMPLATE JS -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/js/main.js"></script>

    <script>
        // Theme toggle (persist in localStorage and server-side if logged)
        (function () {
            const toggle = document.getElementById('themeToggle');
            const root = document.documentElement;
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const isAuthenticated = @((User.Identity?.IsAuthenticated ?? false) ? "true" : "false");
            function updateIcon(theme) {
                if (!toggle) return;
                const useEl = toggle.querySelector('use');
                if (!useEl) return;
                useEl.setAttribute('href', theme === 'dark' ? '#icon-moon' : '#icon-sun');
            }
            async function setTheme(theme) {
                if (theme === 'dark') root.setAttribute('data-theme', 'dark');
                else root.removeAttribute('data-theme');
                localStorage.setItem('theme', theme);
                updateIcon(theme);

                // Only attempt server update when authenticated and token is present
                if (isAuthenticated === 'true' && tokenInput) {
                    try {
                        await fetch('/Profile/SetThemePreference', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': tokenInput.value
                            },
                            body: JSON.stringify({ theme })
                        });
                    } catch (e) {
                        // ignore errors
                    }
                }
            }
            const saved = localStorage.getItem('theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            setTheme(saved);
            if (toggle) {
                toggle.addEventListener('click', () => {
                    const current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                    setTheme(current === 'dark' ? 'light' : 'dark');
                });
            }
        })();
    </script>

    <!-- OPTIONAL: Initialize AOS -->
    <script>
        AOS.init();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
